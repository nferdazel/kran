{
  "name": "@kran/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "comment": "Shell SvelteKit (spec §14). SPA (adapter-static + fallback); e2e Playwright + axe (spec §17.2). Versi dependency dipin (spec §18.2).",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "svelte-kit sync",
    "i18n:compile": "paraglide-js compile --project ../../packages/i18n/project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "e2e": "playwright test",
    "test": "vitest run"
  },
  "dependencies": {
    "@kran/ui": "workspace:*",
    "@kran/api-client": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@inlang/paraglide-js": "2.27.0",
    "@playwright/test": "1.65.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
