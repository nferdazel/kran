# kran-api.service — unit systemd USER untuk API KRAN (--role=api).
#
# Spec: §21.4 (#10, #11), §21.5 (Unit), §22 (health /healthz + /readyz).
#
# Binary native (bukan container): /srv/qouver/apps/kran/bin/kran-api.
# Pasang di server sebagai ~/.config/systemd/user/kran-api.service, lalu:
#   systemctl --user daemon-reload && systemctl --user enable --now kran-api
#
# Env bootstrap (mode 600, di LUAR repo): /srv/qouver/apps/kran/env/kran-prod.env
# Nilai bisnis TIDAK di sini — semuanya dari parameter DB (§10).
#
# Port transisi §21.5: 127.0.0.1:8095 (diambil alih dari cbs-core saat cutover,
# jangan bertabrakan selama cbs-core masih melayani).
#
# CATATAN (jujur): directive pengerasan namespace (ProtectSystem/ProtectHome)
# hanya dijamin untuk *system* unit; sebagian diabaikan untuk user unit. Karena
# itu hanya ditempel sebagai komentar sampai diverifikasi di server dengan
# `systemd-analyze security --user kran-api`. NoNewPrivileges aman untuk user unit.

[Unit]
Description=KRAN API (Nim, --role=api)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/qouver/apps/kran
EnvironmentFile=/srv/qouver/apps/kran/env/kran-prod.env
# Lib runtime (libpq) tidak ada di host; di-vendor oleh deploy-vps.sh.
Environment=LD_LIBRARY_PATH=/srv/qouver/apps/kran/lib
# Port/alamat dari EnvironmentFile di atas. Biner **tidak** membaca KRAN_PORT sendiri (hanya flag
# `--port`/`--address`), jadi tanpa dua argumen ini ia memakai default 8080 — dan 8080 di server ini
# sudah dipakai container lain (ditemukan di T-045, 16 Okt 2026: app crash-loop "Address already in use").
ExecStart=/srv/qouver/apps/kran/bin/kran-api --role=api --port=${KRAN_PORT} --address=${KRAN_BIND_HOST}
Restart=always
# Kesalahan konfigurasi bersifat permanen: restart-loop hanya mengulang galat yang sama. Kebijakan
# worker (`kran-worker.service`) sudah begitu untuk exit 3 ("belum dikonfigurasi"); di sini exit 2 =
# argumen/konfigurasi tidak sah, termasuk berkas KEK yang hilang/rusak/mode bukan 600 (T-054).
RestartPreventExitStatus=2
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

# Opsional, verifikasi dulu di server (kemungkinan diabaikan pada user unit):
# ProtectSystem=full
# ProtectHome=read-only
# ReadWritePaths=/srv/qouver/apps/kran

[Install]
WantedBy=default.target
