# cbs-api.service — unit systemd USER untuk API CBS (--role=api).
#
# Spec: §21.4 (#10, #11), §21.5 (Unit), §22 (health /healthz + /readyz).
#
# Binary native (bukan container): /srv/qouver/apps/cbs/bin/cbs-api.
# Pasang di server sebagai ~/.config/systemd/user/cbs-api.service, lalu:
#   systemctl --user daemon-reload && systemctl --user enable --now cbs-api
#
# Env bootstrap (mode 600, di LUAR repo): /srv/qouver/apps/cbs/env/cbs-prod.env
# Nilai bisnis TIDAK di sini — semuanya dari parameter DB (§10).
#
# Port transisi §21.5: 127.0.0.1:8095 (diambil alih dari cbs-core saat cutover,
# jangan bertabrakan selama cbs-core masih melayani).
#
# CATATAN (jujur): directive pengerasan namespace (ProtectSystem/ProtectHome)
# hanya dijamin untuk *system* unit; sebagian diabaikan untuk user unit. Karena
# itu hanya ditempel sebagai komentar sampai diverifikasi di server dengan
# `systemd-analyze security --user cbs-api`. NoNewPrivileges aman untuk user unit.

[Unit]
Description=CBS API (Nim, --role=api)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/qouver/apps/cbs
EnvironmentFile=/srv/qouver/apps/cbs/env/cbs-prod.env
ExecStart=/srv/qouver/apps/cbs/bin/cbs-api --role=api
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

# Opsional, verifikasi dulu di server (kemungkinan diabaikan pada user unit):
# ProtectSystem=full
# ProtectHome=read-only
# ReadWritePaths=/srv/qouver/apps/cbs

[Install]
WantedBy=default.target
