# Quadlet unit — kran-worker (Nim, --role=worker), rootless podman + systemd user.
# Pasang di VPS: ~/.config/containers/systemd/kran-worker.container
#
# Satu image, dua peran (API + worker): worker hanya beda argumen.
#
# Sejak T-074 worker menjalankan loop konsumen outbox (posting rule `ledger`), jadi ia
# **long-running**, bukan lagi placeholder yang keluar status 3.
# `[Install]` disediakan supaya bisa di-enable saat boot; skrip deploy memasang + me-restart unit,
# tetapi meng-enable boot adalah tindakan host (`systemctl --user enable kran-worker`) yang tidak
# dilakukan otomatis dari repo (AGENTS §3).
# Status 2 = parameter posting belum tersemai/DB tidak terbaca: gagal-cepat, jangan crash-loop.
[Unit]
Description=KRAN Worker (Nim, --role=worker)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/kran-api:local
# Env-file yang sama memuat KRAN_KEK_FILE; mount + pemetaan uid harus sama dengan API.
UserNS=keep-id:uid=10001,gid=10001
Volume=/srv/qouver/apps/kran/env/kran-kek.key:/run/secrets/kran-kek.key:ro,z
ContainerName=kran-worker
Network=qouver
Pull=never
AutoUpdate=local
EnvironmentFile=/srv/qouver/apps/kran/env/kran-prod.env
Volume=/srv/qouver/apps/kran/monorepo/modules:/monorepo/modules:z,ro
Exec=--role=worker --root=/monorepo
NoNewPrivileges=true
DropCapability=ALL

[Install]
WantedBy=default.target

[Service]
Restart=always
# Paritas dengan unit native: status 3 = "dikenali tetapi belum bisa dijalankan",
# bukan crash. Tanpa baris ini systemd mengulang start tiap 3 detik.
RestartPreventExitStatus=2 3
RestartSec=3
