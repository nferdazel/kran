# kran-prod.env.example — contoh env bootstrap KRAN (api & worker).
#
# Spec: §21.5 (env/bootstrap config saja), §21.4 (env mode 600 di luar repo),
# §10 (nilai bisnis TIDAK di env — selalu dari parameter DB), §12.5.
#
# Salin ke server sebagai /srv/qouver/apps/kran/env/kran-prod.env (mode 600,
# owner sachiel). JANGAN commit nilai asli. Hanya *.example yang masuk repo.
#
# Nama variabel di bawah mengikuti yang benar-benar dibaca kode saat ini
# (shared/platform-lib/db/config.nim). Yang belum dibaca kode ditandai komentar.

# ── Koneksi DB (dibaca: shared/platform-lib/db/config.nim) ──
# Role terpisah untuk least privilege (spec §21.5): app / migrate / readonly.
# Parser URL saat ini TIDAK menerima parameter kueri/sslmode (lihat catatan modul).
KRAN_DATABASE_URL=postgres://kran_app:CHANGE_ME@127.0.0.1:5432/kran
KRAN_DB_POOL_SIZE=8
KRAN_DB_ACQUIRE_TIMEOUT_MS=5000
# Batas membuka koneksi baru; libpq menafsirkan nilai < 2 detik sebagai 2 detik.
KRAN_DB_CONNECT_TIMEOUT_MS=5000
KRAN_DB_STATEMENT_TIMEOUT_MS=15000
# Batas satu blok kerja (withConn/withTx). Default = statement_timeout + 5000; nilai eksplisit
# WAJIB > statement_timeout, kalau tidak aplikasi menolak start (kueri sah tidak boleh dibunuh).
KRAN_DB_QUERY_DEADLINE_MS=20000
KRAN_DB_VALIDATE_ON_ACQUIRE=1
KRAN_APP_NAME=kran-api

# ── Observability (spec §22) ──
# JSON terstruktur + correlation ID: default; endpoint metrics di 127.0.0.1 saja.
# Prometheus scrape langsung ke 127.0.0.1 (tidak lewat domain publik) — §22.
# KRAN_LOG_LEVEL=info   # belum dibaca kode (level log masih konstanta di platform-lib/log.nim)

# ── Kunci enkripsi field (spec §18.2, ADR-017/D-048, O-006) ──
# Dibaca shared/platform-lib/crypto/fieldcrypto.nim. Kosong = belum ada kolom terenkripsi:
# aplikasi tetap start, enkripsi/dekripsi menolak eksplisit. Diisi = berkas KEK dibaca &
# divalidasi saat startup (hilang/rusak/mode bukan 600 → tolak start).
# Berkas mode 600 di luar repo, TERPISAH dari DB: TIDAK ikut backup DB (O-006).
# Hilang = data terenkripsi tak bisa dibaca. Runbook: docs/runbooks/field-encryption.md
# Nilai DI BAWAH berlaku di dalam container (OPS-6): quadlet me-mount berkas host
# `/srv/qouver/apps/kran/env/kran-kek.key` ke `/run/secrets/kran-kek.key` (read-only, uid 10001).
# Menulis path host di sini membuat container gagal start dengan kode 2 — berkas host tidak ada di
# namespace container. Perintah yang berjalan di HOST (mis. `ctl` manual) memakai path host.
# KRAN_KEK_FILE=/run/secrets/kran-kek.key

# ── Belum dibaca kode (menunggu ADR-002 / T-010) — jangan diandalkan dulu ──
# Port HTTP & bind address: keputusan HTTP server (ADR-002, masih terbuka).
# KRAN_PORT=8095
# KRAN_BIND_HOST=127.0.0.1
# Role default (ExecStart unit sudah memakai --role=api|worker).
# KRAN_ROLE=api
