# Caddyfile.kran.example — blok Caddy untuk KRAN.
#
# Spec: §21.5 (site/hostname terpisah + header keamanan lengkap), §21.6 (versi-kan
# di ops/caddy), audit server 2026-10-13 §4 (P2: header keamanan tidak seragam).
#
# Ini CONTOH: file Caddyfile di server (/etc/caddy/Caddyfile) tetap sumber
# kebenaran. Salin blok yang relevan, lalu `caddy validate --adapter caddyfile` +
# **`systemctl restart caddy`** — bukan `reload`: server ini memakai `admin off` (audit H-5),
# sehingga `caddy reload` gagal dengan "connection refused" ke 127.0.0.1:2019. Restart memutus
# koneksi yang sedang berjalan selama ~1 detik.
# Hostname sudah diputuskan (D-043, 16 Okt 2026): KRAN memakai `cbs.qouver.com` yang sama dengan
# sistem lama — DNS tidak disentuh, yang berubah hanya upstream saat peralihan.

# ─────────────────────────────────────────────────────────────────────────────
# A. Backoffice web (SPA statis, spec §12, §14). Mengambil alih cbs.qouver.com milik
#    cbs-core saat peralihan (D-043: replace di tempat, domain tetap; §21.5).
#    Web diserve **sebagai berkas statis** dari hasil swap `deploy-vps.sh`
#    (`/srv/qouver/apps/kran/web`) — tidak perlu proses di 3005; port itu hanya
#    dipakai container `cbs-web` selama sistem lama masih jalan.
#    `/api/*` tetap **same-origin** (D-025): browser memanggil API lewat host ini, jadi
#    cookie `SameSite=Strict` tidak perlu diubah dan tidak ada CORS.
# ─────────────────────────────────────────────────────────────────────────────
cbs.qouver.com {
	# Situs live memakai snippet `log_access`; pertahankan supaya log akses tidak hilang saat ganti blok.
	log {
		import log_access
	}

	encode zstd gzip

	# SELinux: akar ini butuh label httpd_sys_content_t (aturan `semanage fcontext` dipasang sekali di
	# server; `deploy-vps.sh` menjalankan `restorecon` tiap swap). Tanpa itu Caddy menerima 403/404.
	root * /srv/qouver/apps/kran/web

	# T-133/OPS-14: batas badan permintaan. Tanpa ini klien bisa mengirim body sebesar apa pun dan
	# Caddy meneruskannya (atau menahannya di disk/memori) sebelum API sempat menolak. Batas ini
	# teknis, bukan kebijakan bisnis: 1 MB jauh di atas body terbesar yang sah (jurnal, parameter,
	# form) dan tetap menutup kiriman sampah berukuran raksasa.
	request_body {
		max_size 1MB
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8095 {
			# T-133/OPS-14: timeout transport. Default Caddy membiarkan koneksi ke upstream
			# menggantung; permintaan lambat menahan goroutine tanpa batas dan membuat
			# `/readyz`/health gate tidak mencerminkan layanan yang benar-benar melayani.
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 60s
				# Koneksi keepalive ke upstream dipendekkan supaya restart container
				# (deploy) tidak menunggu koneksi lama habis dulu.
				keepalive 30s
			}
		}
	}
	handle {
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# CSP awal (spec §21.5 meminta CSP + frame-ancestors). Sesuaikan setelah
		# T-010 (aset SvelteKit mungkin butuh nonce/hash). frame-ancestors di sini
		# melengkapi X-Frame-Options.
		# CSP: kebijakan lengkapnya datang dari **meta** yang diterbitkan Kit (`csp` mode hash di
		# `vite.config.ts`) — hash-nya berubah tiap build, jadi tidak mungkin ditulis statis di sini.
		# Header ini hanya membawa `frame-ancestors`, satu-satunya direktif yang diabaikan browser
		# bila ditulis di `<meta>`. **Jangan** menambahkan `script-src` di sini: dua kebijakan CSP
		# diirisan, sehingga `script-src 'self'` tanpa hash justru memblokir script inline ber-hash
		# milik Kit dan halaman berhenti ter-hidrasi (O-061).
		Content-Security-Policy "frame-ancestors 'none'"
	}
}

# ─────────────────────────────────────────────────────────────────────────────
# B. API — hostname TERPISAH hanya bila nanti pemilik memutuskan record DNS baru.
#    Menurut D-043 **tidak dipakai sekarang**: API dijangkau lewat `/api/*` pada
#    cbs.qouver.com (blok A) dan lewat `api.qouver.com/cbs/*` yang sudah ada.
#    Blok ini disimpan sebagai contoh bila hostname terpisah diinginkan (§21.5).
# ─────────────────────────────────────────────────────────────────────────────
kran-api.qouver.com {
	encode zstd gzip

	# Metrik Prometheus bukan untuk publik (§22): scrape langsung ke 127.0.0.1.
	handle /metrics* {
		respond 403
	}
	handle {
		reverse_proxy 127.0.0.1:8095
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# ─────────────────────────────────────────────────────────────────────────────
# C. Transisi saja: hanya bila API lama masih dilayani berdampingan. Menurut D-043 KRAN
#    menggantikan di port yang sama (8095), jadi blok ini tidak dipakai setelah peralihan.
#    Gabungkan `handle` ini ke blok
#    `api.qouver.com` yang SUDAH ADA. Header ditambahkan di dalam handle supaya
#    tidak bergantung pada blok induk yang saat ini tanpa header (§21.5).
#
#    handle /cbs/* {
#        uri strip_prefix /cbs
#        reverse_proxy 127.0.0.1:8095
#        header {
#            Strict-Transport-Security "max-age=31536000"
#            X-Content-Type-Options "nosniff"
#            X-Frame-Options "DENY"
#            Referrer-Policy "strict-origin-when-cross-origin"
#        }
#    }
#    handle /hooks/* {
#        reverse_proxy 127.0.0.1:9000
#    }
# ─────────────────────────────────────────────────────────────────────────────
