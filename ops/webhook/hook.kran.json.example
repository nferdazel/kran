[
  {
    "id": "kran",
    "execute-command": "/srv/qouver/apps/kran/scripts/deploy-vps.sh",
    "command-working-directory": "/srv/qouver/apps/kran",
    "pass-arguments-to-command": [
      {
        "source": "payload",
        "name": "repository.name"
      },
      {
        "source": "payload",
        "name": "ref"
      }
    ],
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "YOUR_WEBHOOK_HMAC_SECRET",
            "parameter": {
              "source": "header",
              "name": "X-Hub-Signature-256"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "push",
            "parameter": {
              "source": "header",
              "name": "X-GitHub-Event"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "kran",
            "parameter": {
              "source": "payload",
              "name": "repository.name"
            }
          }
        }
      ]
    }
  }
]
