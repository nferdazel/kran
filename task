#!/usr/bin/env sh
#
# KRAN - satu pintu perintah (AGENTS.md 2).
#
#   ./task check   format + lint + archcheck + lint-nomagic + paramgen --check + i18n check
#   ./task test    unit + property + integration (Postgres) + contract
#   ./task e2e     web: kontras token + svelte-check + Playwright (axe 2 tema x 2 locale, keyboard,
#                   alur login/maker-checker/realtime bila KRAN_DATABASE_URL tersedia)
#   ./task openapi lint kontrak OpenAPI + cek klien TS sinkron (openapi-gen = tulis ulang)
#   ./task ci      semua di atas
#   ./task ci-repeat [N]  ulangi gate penuh N kali (bawaan 3) - gate kestabilan (T-031)
#   ./task build   bangun binary apps/api
#   ./task fmt     rapikan format (menulis ulang berkas)
#   ./task devdb   kelola DB dev di server (tunnel) - lihat tools/devdb.sh
#   ./task dbtools migrate|status|validate   migrasi SQL (butuh KRAN_DATABASE_URL)
#   ./task scaffold <nama> [--dry-run]       buat kerangka modul baru (spec §5.5)
#   ./task help
#
# Skrip POSIX sengaja dipilih alih-alih Taskfile/just: tanpa dependensi tooling baru,
# perintah yang sama dipakai laptop dan CI. Lihat docs/DECISIONS.md D-001.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"

BUILD="$ROOT/.build"
BIN="$BUILD/bin"
NIMPATH="-p:$ROOT/shared -p:$ROOT/modules -p:$ROOT/apps -p:$ROOT/tools -p:$ROOT/tools/dbtools"
NIMFLAGS="--hints:off --warnings:on --path:$ROOT/shared --path:$ROOT/modules --path:$ROOT/apps --path:$ROOT/tools"
# Test dikompilasi (dan di-check) dengan `--threads:on`, sama seperti biner API: beberapa test
# integrasi mereproduksi interleaving dua koneksi DB (balapan double-approve, invarian kursor
# outbox) yang hanya mungkin dengan thread nyata (O-040).
TESTFLAGS="$NIMFLAGS --threads:on"

# Bootstrap config lokal (bukan nilai bisnis): KRAN_DATABASE_URL untuk test integrasi.
if [ -f "$ROOT/.local/dev.env" ]; then
  set -a
  . "$ROOT/.local/dev.env"
  set +a
fi
: "${KRAN_DATABASE_URL:=}"

mkdir -p "$BUILD" "$BIN"

SKIPS=""

log()  { printf '\n== %s\n' "$*"; }
info() { printf '   %s\n' "$*"; }
ok()   { printf '   ok: %s\n' "$*"; }
die()  { printf '\n!! GAGAL: %s\n' "$*" >&2; exit 1; }
skip() { printf '\n-- SKIP: %s\n' "$*"; SKIPS="$SKIPS
   - $*"; }
have() { command -v "$1" >/dev/null 2>&1; }

nim_files() {
  # Fixture test tidak pernah dikompilasi: banyak yang sengaja tidak valid.
  find apps modules shared tools -name '*.nim' -not -path '*/tests/fixtures/*' 2>/dev/null | sort
}
fmt_files() {
  # Kode hasil generate (paramgen) milik generator, bukan tangan: nimpretty dilewati supaya
  # `paramgen --check` tetap bisa menuntut kesamaan byte-per-byte. Tetap di-nim-check.
  nim_files | grep -v '/generated/' || true
}
test_files() {
  find apps modules shared tools -path '*/tests/t*.nim' 2>/dev/null | sort
}
it_files() {
  find apps modules shared tools -path '*/tests/it*.nim' 2>/dev/null | sort
}

build_tool() { # build_tool <dir berisi main.nim> -> cetak path binary
  mkdir -p "$BIN"
  name=$(basename "$1")
  nim c $NIMFLAGS --out:"$BIN/$name" "$1/main.nim" >/dev/null || die "gagal build tool $1"
  printf '%s/%s' "$BIN" "$name"
}

cmd_fmt() {
  have nimpretty || die "nimpretty tidak ada di PATH (bagian dari Nim)"
  for f in $(fmt_files); do nimpretty --indent:2 --maxLineLen:100 "$f" >/dev/null; done
  printf '   ok: format diterapkan\n'
}

cmd_fmt_check() {
  log "format (nimpretty)"
  have nimpretty || die "nimpretty tidak ada di PATH (bagian dari Nim)"
  n=0
  bad=""
  for f in $(fmt_files); do
    n=$((n + 1))
    if ! nimpretty --indent:2 --maxLineLen:100 --stdin <"$f" 2>/dev/null | diff -q - "$f" >/dev/null 2>&1; then
      bad="$bad
   - $f"
    fi
  done
  [ -z "$bad" ] || die "berkas berikut tidak nimpretty-clean:$bad
   jalankan: ./task fmt"
  ok "$n berkas"
}

cmd_lint() {
  log "lint (nim check)"
  n=0
  for f in $(nim_files); do
    n=$((n + 1))
    flags=$NIMFLAGS
    case "$f" in */tests/*) flags=$TESTFLAGS ;; esac
    nim check $flags "$f" >"$BUILD/check.log" 2>&1 || {
      cat "$BUILD/check.log" >&2
      die "nim check gagal: $f"
    }
  done
  ok "$n berkas"
}

cmd_archcheck() {
  log "archcheck (batas arsitektur modul)"
  [ -d "$ROOT/tools/archcheck" ] || { skip "tools/archcheck belum ada (T-003)"; return 0; }
  tool=$(build_tool "$ROOT/tools/archcheck")
  "$tool" "$ROOT" || die "pelanggaran batas arsitektur"
  ok "batas modul bersih"
}

cmd_nomagic() {
  log "lint-nomagic (nilai bisnis tidak boleh di kode)"
  [ -d "$ROOT/tools/lint-nomagic" ] || { skip "tools/lint-nomagic belum ada (T-003)"; return 0; }
  tool=$(build_tool "$ROOT/tools/lint-nomagic")
  "$tool" "$ROOT" || die "magic number bisnis terdeteksi"
  ok "tidak ada magic number bisnis"
}

cmd_paramgen() {
  log "paramgen --check (kode == definisi parameter)"
  [ -d "$ROOT/tools/paramgen" ] || { skip "tools/paramgen belum ada (T-003)"; return 0; }
  tool=$(build_tool "$ROOT/tools/paramgen")
  "$tool" --root "$ROOT" --check || die "kode dan definisi parameter tidak sinkron (jalankan: ./task paramgen-gen)"
  ok "sinkron"
}

cmd_paramgen_gen() {
  tool=$(build_tool "$ROOT/tools/paramgen")
  "$tool" --root "$ROOT" --gen
}

cmd_i18n() {
  log "i18n check (key id+en lengkap, tanpa key yatim)"
  if [ ! -d "$ROOT/packages/i18n/messages" ]; then
    skip "packages/i18n/messages belum ada (T-010)"
    return 0
  fi
  tool=$(build_tool "$ROOT/tools/i18ncheck")
  "$tool" "$ROOT" || die "katalog i18n tidak lengkap"
  ok "katalog i18n lengkap"
}

# Binary lokal dipakai langsung (bukan lewat `pnpm run`) supaya tidak ada install tersembunyi;
# lihat docs/runbooks/dev-web.md.
web_bin() { # web_bin <nama> -> cetak path binary workspace root bila ada
  b="$ROOT/node_modules/.bin/$1"
  [ -x "$b" ] && printf '%s' "$b"
}

cmd_openapi() {
  log "openapi (lint kontrak + klien TS sinkron dengan kontrak)"
  yaml="$ROOT/packages/contracts/openapi/kran-api.yaml"
  ruleset="$ROOT/packages/contracts/openapi/.spectral.yaml"
  generated="$ROOT/packages/api-client/src/generated/schema.d.ts"
  if [ ! -f "$yaml" ]; then
    skip "kontrak OpenAPI belum ada (T-008)"
    return 0
  fi
  spectral=$(web_bin spectral || true)
  gen=$(web_bin openapi-typescript || true)
  if [ -z "$spectral" ] || [ -z "$gen" ]; then
    skip "dependency JS belum terpasang (pnpm install) — lint/generate dilewati"
    return 0
  fi

  "$spectral" lint --ruleset "$ruleset" --fail-severity warn "$yaml" \
    || die "lint OpenAPI gagal"
  ok "kontrak lolos lint (fail-severity warn)"

  tmp="$BUILD/schema.d.ts"
  "$gen" "$yaml" -o "$tmp" >/dev/null || die "generate klien TS gagal"
  if ! diff -q "$tmp" "$generated" >/dev/null 2>&1; then
    die "klien TS tidak sinkron dengan kontrak — jalankan: ./task openapi-gen"
  fi
  ok "klien TS sinkron dengan kontrak"

  tsc=$(web_bin tsc || true)
  if [ -n "$tsc" ]; then
    "$tsc" -p "$ROOT/packages/api-client" --noEmit || die "typecheck paket klien API gagal"
    ok "paket klien API lolos typecheck"
  fi
}

cmd_openapi_gen() {
  yaml="$ROOT/packages/contracts/openapi/kran-api.yaml"
  generated="$ROOT/packages/api-client/src/generated/schema.d.ts"
  gen=$(web_bin openapi-typescript || true)
  [ -n "$gen" ] || die "dependency JS belum terpasang (pnpm install)"
  "$gen" "$yaml" -o "$generated" || die "generate klien TS gagal"
  ok "$generated"
}

cmd_shlint() {
  log "shell sintaks skrip ops (bash -n + shellcheck)"
  files=$(find "$ROOT/ops" -type f -name '*.sh' 2>/dev/null | sort)
  if [ -z "$files" ]; then
    skip "belum ada skrip ops (T-013)"
    return 0
  fi
  for f in $files; do bash -n "$f" || die "sintaks bash salah: $f"; done
  if have shellcheck; then
    # Level `error` memblokir (bug nyata). Temuan level `warning`/`info` dilaporkan saja:
    # kualitas lint penuh belum diverifikasi di mesin pengembang (shellcheck tidak terpasang),
    # jadi belum pantas dijadikan gate yang bisa memblokir tanpa bukti.
    for f in $files; do
      shellcheck -S error "$f" || die "shellcheck (level error): $f"
      shellcheck -S warning -f gcc "$f" 2>/dev/null | head -10 || true
    done
  else
    info "shellcheck tidak ada di PATH — hanya bash -n"
  fi
  ok "$(printf '%s\n' "$files" | wc -l | tr -d ' ') skrip lolos bash -n"
}

cmd_check() {
  mkdir -p "$BUILD"
  cmd_fmt_check
  cmd_lint
  cmd_archcheck
  cmd_nomagic
  cmd_paramgen
  cmd_i18n
  cmd_shlint
}

run_nim_test() { # run_nim_test <berkas>
  f="$1"
  name=$(basename "$f" .nim)
  nim c $TESTFLAGS --out:"$BIN/$name" "$f" >/dev/null || die "gagal kompilasi test $f"
  "$BIN/$name" || die "test gagal: $f"
}

cmd_test() {
  filter="${1:-}"
  matched=0
  log "unit + property test${filter:+ (filter: $filter)}"
  list=$(test_files)
  if [ -n "$filter" ]; then
    list=$(printf '%s\n' "$list" | grep -- "$filter" || true)
  fi
  if [ -z "$list" ]; then
    # Gate ini sengaja asimetris: repo kosong boleh (Fase 0 baru mulai), tetapi kode yang
    # ada tanpa satu pun test = kegagalan. Dengan filter, daftar kosong itu wajar (mis. filter
    # hanya cocok untuk integration test); filter yang tidak cocok dengan test mana pun
    # diperiksa di akhir fungsi.
    [ -z "$(nim_files)" ] || [ -n "$filter" ] || die "ada kode Nim tetapi tidak ada test (cari */tests/t*.nim)"
    [ -n "$filter" ] || skip "belum ada kode maupun test Nim (mulai T-002)"
  else
    matched=1
    for f in $list; do info "$f"; run_nim_test "$f"; done
  fi

  log "integration test (Postgres)"
  its=$(it_files)
  if [ -n "$filter" ]; then
    its=$(printf '%s\n' "$its" | grep -- "$filter" || true)
  fi
  if [ -z "$its" ]; then
    [ -n "$filter" ] || skip "belum ada test integrasi (T-004)"
  elif [ -z "$KRAN_DATABASE_URL" ]; then
    skip "KRAN_DATABASE_URL kosong - test integrasi melewati dirinya sendiri (lihat .local/dev.env / ./task devdb up)"
  else
    matched=1
    for f in $its; do info "$f"; run_nim_test "$f"; done
  fi

  if [ -n "$filter" ] && [ "$matched" -eq 0 ]; then
    die "filter '$filter' tidak cocok dengan test mana pun"
  fi
}

cmd_e2e() {
  if [ ! -f "$ROOT/apps/web/package.json" ]; then
    skip "apps/web/package.json belum ada (T-010)"
    return 0
  fi
  # Binary lokal dipakai langsung, bukan lewat `pnpm run`: pnpm 10+ memasang ulang dependency
  # lebih dulu bila lockfile/package.json dirasa tidak sinkron, dan install itu butuh registry.
  # Di mesin pengembangan registry privat (artifactory) tidak resolve, sehingga `pnpm run` bisa
  # menggantung. Binary lokal deterministik dan tetap benar di CI setelah `pnpm install`.
  web_bin="$ROOT/apps/web/node_modules/.bin"
  ui_bin="$ROOT/packages/ui/node_modules/.bin"
  if [ ! -x "$web_bin/playwright" ] || [ ! -x "$ui_bin/vitest" ]; then
    skip "dependency JS belum terpasang (jalankan: pnpm install) — e2e/a11y dilewati"
    return 0
  fi

  log "kontras token (vitest, packages/ui)"
  (cd "$ROOT/packages/ui" && "$ui_bin/vitest" run) || die "test kontras token gagal"
  ok "pasangan token lolos ambang kontras (light + dark)"

  log "i18n: kompilasi Paraglide + tipe pesan"
  (cd "$ROOT/apps/web" && "$web_bin/paraglide-js" compile \
    --project ../../packages/i18n/project.inlang \
    --outdir ./src/lib/paraglide \
    --emit-ts-declarations >/dev/null) || die "kompilasi Paraglide gagal"
  ok "pesan terkompilasi"

  log "svelte-check (tipe + diagnostik a11y komponen)"
  (cd "$ROOT/apps/web" && "$web_bin/svelte-kit" sync >/dev/null && "$web_bin/svelte-check" --tsconfig ./tsconfig.json) \
    || die "svelte-check menemukan error"
  ok "0 error"

  # API e2e (spec §17.2): hanya bila ada DB. Migrasi + seed dev idempoten dulu, baru Playwright
  # mengangkat binary hasil build di port 8099 (lihat apps/web/playwright.config.ts).
  if [ -z "$KRAN_DATABASE_URL" ]; then
    skip "KRAN_DATABASE_URL kosong — API e2e tidak dijalankan, spec alur login/maker-checker dilewati"
  else
    log "API e2e: build + migrasi + seed dev"
    cmd_build
    mkdir -p "$BUILD"
    dbt=$(build_tool "$ROOT/tools/dbtools")
    "$dbt" --root "$ROOT" migrate || die "migrasi DB dev gagal"
    "$dbt" --root "$ROOT" seed --dev || die "seed dev gagal"
    ok "API e2e siap (migrasi + seed dev idempoten)"
  fi

  log "e2e (Playwright): axe 2 tema x 2 locale + alur keyboard-only + alur login/maker-checker"
  (cd "$ROOT/apps/web" && "$web_bin/playwright" test) || die "e2e gagal"
  ok "e2e hijau"
}

cmd_build() {
  mkdir -p "$BIN"
  [ -f "$ROOT/apps/api/src/main.nim" ] || die "apps/api/src/main.nim belum ada (T-004)"
  nim c $NIMFLAGS --mm:orc --threads:on --out:"$BIN/kran-api" "$ROOT/apps/api/src/main.nim"
  ok "$BIN/kran-api"
}

cmd_scaffold() { # cmd_scaffold <nama> [--dry-run]
  log "scaffold modul baru"
  [ -d "$ROOT/tools/scaffold" ] || die "tools/scaffold belum ada (T-011)"
  tool=$(build_tool "$ROOT/tools/scaffold")
  "$tool" --root "$ROOT" "$@" || die "scaffold gagal"
}

summarize() {
  if [ -n "$SKIPS" ]; then
    printf '\n== catatan: target yang dilewati (belum ada / menunggu keputusan):%s\n' "$SKIPS"
  fi
}

cmd_ci() {
  cmd_check
  cmd_openapi
  cmd_test
  cmd_e2e
  summarize
  printf '\n== CI hijau\n'
}

# Gate kestabilan: `./task ci` menjawab "lulus sekarang", bukan "stabil". Flake hanya terlihat saat
# diulang, jadi gate penuh dijalankan N kali berturut-turut dan berhenti pada putaran pertama yang
# merah (T-031). Sengaja tidak dipakai di setiap task: satu putaran sudah ~8 menit.
cmd_ci_repeat() { # cmd_ci_repeat [jumlah-putaran]
  putaran_total=${1:-3}
  case "$putaran_total" in
    '' | *[!0-9]*) die "jumlah putaran harus angka (mis. ./task ci-repeat 3)" ;;
  esac
  [ "$putaran_total" -ge 1 ] || die "jumlah putaran minimal 1"
  putaran=1
  while [ "$putaran" -le "$putaran_total" ]; do
    log "ci-repeat: putaran $putaran/$putaran_total"
    cmd_ci || die "ci-repeat gagal pada putaran $putaran/$putaran_total"
    putaran=$((putaran + 1))
  done
  printf '\n== ci-repeat hijau: %s putaran berturut-turut\n' "$putaran_total"
}

cmd_help() {
  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-help}" in
  check) cmd_check ;;
  test) shift; cmd_test "${1:-}" ;;
  e2e) cmd_e2e ;;
  ci) cmd_ci ;;
  ci-repeat) shift; cmd_ci_repeat "${1:-3}" ;;
  build) cmd_build ;;
  fmt) cmd_fmt ;;
  lint) cmd_lint ;;
  archcheck) mkdir -p "$BUILD"; cmd_archcheck ;;
  nomagic) mkdir -p "$BUILD"; cmd_nomagic ;;
  paramgen) mkdir -p "$BUILD"; cmd_paramgen ;;
  paramgen-gen) mkdir -p "$BUILD"; cmd_paramgen_gen ;;
  i18n) mkdir -p "$BUILD"; cmd_i18n ;;
  openapi) mkdir -p "$BUILD"; cmd_openapi ;;
  openapi-gen) mkdir -p "$BUILD"; cmd_openapi_gen ;;
  devdb) shift; exec "$ROOT/tools/devdb.sh" "$@" ;;
  dbtools) shift; mkdir -p "$BUILD"; tool=$(build_tool "$ROOT/tools/dbtools"); "$tool" --root "$ROOT" "$@" ;;
  scaffold) shift; mkdir -p "$BUILD"; cmd_scaffold "$@" ;;
  help | -h | --help) cmd_help ;;
  *) die "perintah tidak dikenal: $1 (coba ./task help)" ;;
esac
