#!/usr/bin/env sh
#
# KRAN — single entry point task runner (AGENTS.md §2).
#
#   ./task check   format + lint + archcheck + lint-nomagic + paramgen --check + i18n check
#   ./task check-fast  like check without full `nim check` (dev iteration loop, D-077)
#   ./task verify [filter]  check-fast + openapi + build + test selected modules (D-077)
#   ./task test    unit + property + integration (Postgres) + contract
#   ./task e2e     web: token contrast + svelte-check + Playwright (axe 2 themes x 2 locales, keyboard,
#                   login/maker-checker/realtime flows if KRAN_DATABASE_URL is available)
#   ./task lint-web  eslint (typescript-eslint + svelte/*, non-a11y) over apps/web + packages/ui
#   ./task openapi lint OpenAPI contract + verify TS client sync (openapi-gen = rewrite)
#   ./task ci      all gates above
#   ./task ci-repeat [N]  repeat full gate N times (default 3) - stability gate (T-031)
#   ./task build   build apps/api binary
#   ./task fmt     format code (rewrites files in place)
#   ./task devdb   manage dev DB tunnel to server - see tools/devdb.sh
#   ./task dbtools migrate|status|validate   SQL migrations (requires KRAN_DATABASE_URL)
#   ./task scaffold <name> [--dry-run]       scaffold a new module (spec §5.5)
#   ./task bench-password [--iterations N]   benchmark password hashing cost (T-060)
#   ./task help
#
# Pure POSIX script chosen over Taskfile/just: zero new tooling dependencies,
# identical commands used on developer machines and CI. See docs/DECISIONS.md D-001.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"

BUILD="$ROOT/.build"
BIN="$BUILD/bin"
NIMPATH="-p:$ROOT/shared -p:$ROOT/modules -p:$ROOT/apps -p:$ROOT/tools -p:$ROOT/tools/dbtools"
NIMFLAGS="--hints:off --warnings:on --path:$ROOT/shared --path:$ROOT/modules --path:$ROOT/apps --path:$ROOT/tools"
# Tests are compiled (and checked) with `--threads:on`, matching API binary: several integration
# tests reproduce interleaving between two DB connections (double-approve races, outbox cursor invariants)
# which are only possible with real threads (O-040).
TESTFLAGS="$NIMFLAGS --threads:on"

# Bootstrap local config (non-business value): KRAN_DATABASE_URL for integration tests.
if [ -f "$ROOT/.local/dev.env" ]; then
  set -a
  . "$ROOT/.local/dev.env"
  set +a
fi
: "${KRAN_DATABASE_URL:=}"

mkdir -p "$BUILD" "$BIN"

SKIPS=""

log()  { printf '\n== %s\n' "$*"; }
info() { printf '   %s\n' "$*"; }
ok()   { printf '   ok: %s\n' "$*"; }
die()  { printf '\n!! FAILED: %s\n' "$*" >&2; exit 1; }
skip() { printf '\n-- SKIP: %s\n' "$*"; SKIPS="$SKIPS
   - $*"; }
have() { command -v "$1" >/dev/null 2>&1; }

nim_files() {
  # Test fixtures are never compiled: many are intentionally invalid.
  find apps modules shared tools -name '*.nim' -not -path '*/tests/fixtures/*' 2>/dev/null | sort
}
fmt_files() {
  # Generated code (paramgen) belongs to generator, not hand-edited: nimpretty is skipped so
  # `paramgen --check` can still enforce byte-for-byte equality. Still checked via nim check.
  nim_files | grep -v '/generated/' || true
}
test_files() {
  find apps modules shared tools -path '*/tests/t*.nim' 2>/dev/null | sort
}
it_files() {
  find apps modules shared tools -path '*/tests/it*.nim' 2>/dev/null | sort
}

build_tool() { # build_tool <dir containing main.nim> -> print binary path
  mkdir -p "$BIN"
  name=$(basename "$1")
  nim c $NIMFLAGS --out:"$BIN/$name" "$1/main.nim" >/dev/null || die "failed to build tool $1"
  printf '%s/%s' "$BIN" "$name"
}

cmd_fmt() {
  have nimpretty || die "nimpretty not found in PATH (part of Nim)"
  for f in $(fmt_files); do nimpretty --indent:2 --maxLineLen:100 "$f" >/dev/null; done
  printf '   ok: formatting applied\n'
}

cmd_fmt_check() {
  log "format (nimpretty)"
  have nimpretty || die "nimpretty not found in PATH (part of Nim)"
  n=0
  bad=""
  for f in $(fmt_files); do
    n=$((n + 1))
    if ! nimpretty --indent:2 --maxLineLen:100 --stdin <"$f" 2>/dev/null | diff -q - "$f" >/dev/null 2>&1; then
      bad="$bad
   - $f"
    fi
  done
  [ -z "$bad" ] || die "following files are not nimpretty-clean:$bad
   run: ./task fmt"
  ok "$n files"
}

cmd_lint() {
  jobs="${KRAN_LINT_JOBS:-4}"
  log "lint (nim check, parallel $jobs)"
  files=$(nim_files)
  n=$(printf '%s\n' "$files" | wc -l | tr -d ' ')
  # Each file nim check-ed separately, per-file log, only failures printed.
  # This only changes execution mechanics; gate coverage remains all files (D-077).
  export NIMFLAGS TESTFLAGS
  LINTDIR=$BUILD
  export LINTDIR
  rm -f "$BUILD/lint-failures.txt"
  printf '%s\n' "$files" | xargs -P "$jobs" -I{} sh -c '
    f="$1"
    flags="$NIMFLAGS"
    case "$f" in */tests/*) flags="$TESTFLAGS" ;; esac
    out="$LINTDIR/check.$(printf "%s" "$f" | tr "/ " "__").log"
    if nim check $flags "$f" >"$out" 2>&1; then
      rm -f "$out"
    else
      printf "%s\n" "$f"
    fi
  ' _ {} >"$BUILD/lint-failures.txt" || true
  if [ -s "$BUILD/lint-failures.txt" ]; then
    while IFS= read -r f; do
      printf -- "--- nim check failed: %s\n" "$f" >&2
      cat "$BUILD/check.$(printf "%s" "$f" | tr "/ " "__").log" >&2 || true
    done <"$BUILD/lint-failures.txt"
    die "nim check failed: $(wc -l <"$BUILD/lint-failures.txt" | tr -d ' ') files"
  fi
  ok "$n files"
}

cmd_archcheck() {
  log "archcheck (module architecture boundaries)"
  [ -d "$ROOT/tools/archcheck" ] || { skip "tools/archcheck not found (T-003)"; return 0; }
  tool=$(build_tool "$ROOT/tools/archcheck")
  "$tool" "$ROOT" || die "architecture boundary violation"
  ok "clean module boundaries"
}

cmd_nomagic() {
  log "lint-nomagic (business values must not be hardcoded)"
  [ -d "$ROOT/tools/lint-nomagic" ] || { skip "tools/lint-nomagic not found (T-003)"; return 0; }
  tool=$(build_tool "$ROOT/tools/lint-nomagic")
  "$tool" "$ROOT" || die "business magic number detected"
  ok "no business magic numbers found"
}

cmd_paramgen() {
  log "paramgen --check (code == parameter definitions)"
  [ -d "$ROOT/tools/paramgen" ] || { skip "tools/paramgen not found (T-003)"; return 0; }
  tool=$(build_tool "$ROOT/tools/paramgen")
  "$tool" --root "$ROOT" --check || die "code and parameter definitions out of sync (run: ./task paramgen-gen)"
  ok "in sync"
}

cmd_paramgen_gen() {
  tool=$(build_tool "$ROOT/tools/paramgen")
  "$tool" --root "$ROOT" --gen
}

cmd_i18n() {
  log "i18n check (key id+en complete, no orphan keys)"
  if [ ! -d "$ROOT/packages/i18n/messages" ]; then
    skip "packages/i18n/messages not found (T-010)"
    return 0
  fi
  tool=$(build_tool "$ROOT/tools/i18ncheck")
  "$tool" "$ROOT" || die "i18n catalog incomplete"
  ok "i18n catalog complete"
}

# Local binaries used directly (not via `pnpm run`) to avoid implicit installs;
# see docs/runbooks/dev-web.md.
web_bin() { # web_bin <name> -> print binary path from workspace root if present
  b="$ROOT/node_modules/.bin/$1"
  [ -x "$b" ] && printf '%s' "$b"
}

cmd_openapi() {
  log "openapi (contract lint + TS client in sync with contract)"
  yaml="$ROOT/packages/contracts/openapi/kran-api.yaml"
  ruleset="$ROOT/packages/contracts/openapi/.spectral.yaml"
  generated="$ROOT/packages/api-client/src/generated/schema.d.ts"
  if [ ! -f "$yaml" ]; then
    skip "OpenAPI contract not found (T-008)"
    return 0
  fi
  spectral=$(web_bin spectral || true)
  gen=$(web_bin openapi-typescript || true)
  if [ -z "$spectral" ] || [ -z "$gen" ]; then
    skip "JS dependencies not installed (pnpm install) — lint/generate skipped"
    return 0
  fi

  "$spectral" lint --ruleset "$ruleset" --fail-severity warn "$yaml" \
    || die "OpenAPI lint failed"
  ok "contract passed lint (fail-severity warn)"

  tmp="$BUILD/schema.d.ts"
  "$gen" "$yaml" -o "$tmp" >/dev/null || die "TS client generation failed"
  if ! diff -q "$tmp" "$generated" >/dev/null 2>&1; then
    die "TS client out of sync with contract — run: ./task openapi-gen"
  fi
  ok "TS client in sync with contract"

  tsc=$(web_bin tsc || true)
  if [ -n "$tsc" ]; then
    "$tsc" -p "$ROOT/packages/api-client" --noEmit || die "API client package typecheck failed"
    ok "API client package passed typecheck"
  fi
}

cmd_openapi_gen() {
  yaml="$ROOT/packages/contracts/openapi/kran-api.yaml"
  generated="$ROOT/packages/api-client/src/generated/schema.d.ts"
  gen=$(web_bin openapi-typescript || true)
  [ -n "$gen" ] || die "JS dependencies not installed (pnpm install)"
  "$gen" "$yaml" -o "$generated" || die "TS client generation failed"
  ok "$generated"
}

cmd_shlint() {
  log "ops script shell syntax (bash -n + shellcheck)"
  files=$(find "$ROOT/ops" -type f -name '*.sh' 2>/dev/null | sort)
  if [ -z "$files" ]; then
    skip "no ops scripts found (T-013)"
    return 0
  fi
  for f in $files; do bash -n "$f" || die "bash syntax error: $f"; done
  if have shellcheck; then
    # `warning` level blocks since T-050(b)/O-014: `shellcheck -S warning ops/scripts/*.sh`
    # was verified clean on dev machines across all 7 scripts (17 Oct 2026).
    for f in $files; do
      shellcheck -S warning "$f" || die "shellcheck (warning level): $f"
    done
  elif [ "${KRAN_SKIP_SHELLCHECK:-0}" = "1" ]; then
    info "shellcheck skipped (KRAN_SKIP_SHELLCHECK=1) — bash -n only"
  else
    die "shellcheck not found in PATH (install: brew install shellcheck / apt-get install shellcheck); set KRAN_SKIP_SHELLCHECK=1 to skip intentionally"
  fi
  ok "$(printf '%s\n' "$files" | wc -l | tr -d ' ') scripts passed bash -n + shellcheck (warning level)"
}

cmd_check_fast() {
  mkdir -p "$BUILD"
  cmd_fmt_check
  cmd_archcheck
  cmd_nomagic
  cmd_paramgen
  cmd_i18n
  cmd_shlint
}

cmd_verify() {
  filter="${1:-}"
  cmd_check_fast
  cmd_openapi
  cmd_build
  cmd_test "$filter"
}

cmd_check() {
  mkdir -p "$BUILD"
  cmd_fmt_check
  cmd_lint
  cmd_archcheck
  cmd_nomagic
  cmd_paramgen
  cmd_i18n
  cmd_shlint
}

run_nim_test() { # run_nim_test <file>
  f="$1"
  name=$(basename "$f" .nim)
  nim c $TESTFLAGS --out:"$BIN/$name" "$f" >/dev/null || die "failed to compile test $f"
  "$BIN/$name" || die "test failed: $f"
}

select_tests() {
  # `strict=1` = filter matches exact filename in any suite, so only that file is run (tproduct != itproduct).
  # `strict=0` = substring match, for broad filters like `product` (D-077).
  all="$1"
  filter="$2"
  strict="$3"
  [ -n "$filter" ] || { printf '%s\n' "$all"; return; }
  if [ "$strict" = "1" ]; then
    for f in $all; do
      if [ "$(basename "$f" .nim)" = "$filter" ]; then
        printf '%s\n' "$f"
      fi
    done
  else
    printf '%s\n' "$all" | grep -- "$filter" || true
  fi
  return 0
}

cmd_test() {
  filter="${1:-}"
  matched=0
  strict=0
  if [ -n "$filter" ]; then
    for f in $(test_files) $(it_files); do
      if [ "$(basename "$f" .nim)" = "$filter" ]; then
        strict=1
      fi
    done
  fi
  log "unit + property test${filter:+ (filter: $filter)}"
  list=$(test_files)
  list=$(select_tests "$list" "$filter" "$strict")
  if [ -z "$list" ]; then
    # This gate is intentionally asymmetric: empty repo is allowed (Phase 0 starting), but
    # existing code without any test is a failure. With filter, empty list is normal;
    # non-matching filter is checked at end of function.
    [ -z "$(nim_files)" ] || [ -n "$filter" ] || die "Nim code present but no tests found (search */tests/t*.nim)"
    [ -n "$filter" ] || skip "no Nim code or tests yet (start T-002)"
  else
    matched=1
    for f in $list; do info "$f"; run_nim_test "$f"; done
  fi

  log "integration test (Postgres)"
  its=$(it_files)
  its=$(select_tests "$its" "$filter" "$strict")
  if [ -z "$its" ]; then
    [ -n "$filter" ] || skip "no integration tests yet (T-004)"
  elif [ -z "$KRAN_DATABASE_URL" ]; then
    skip "KRAN_DATABASE_URL is empty - integration tests skip themselves (see .local/dev.env / ./task devdb up)"
  else
    matched=1
    for f in $its; do info "$f"; run_nim_test "$f"; done
  fi

  if [ -n "$filter" ] && [ "$matched" -eq 0 ]; then
    die "filter '$filter' did not match any tests"
  fi
}

cmd_e2e() {
  if [ ! -f "$ROOT/apps/web/package.json" ]; then
    skip "apps/web/package.json not found (T-010)"
    return 0
  fi
  # Local binaries used directly, not via `pnpm run`: pnpm 10+ reinstalls dependencies
  # if lockfile/package.json appears out of sync, which requires registry access.
  web_bin="$ROOT/apps/web/node_modules/.bin"
  ui_bin="$ROOT/packages/ui/node_modules/.bin"
  if [ ! -x "$web_bin/playwright" ] || [ ! -x "$web_bin/vitest" ] || [ ! -x "$ui_bin/vitest" ]; then
    skip "JS dependencies not installed (run: pnpm install) — e2e/a11y skipped"
    return 0
  fi

  log "token contrast (vitest, packages/ui)"
  (cd "$ROOT/packages/ui" && "$ui_bin/vitest" run) || die "token contrast test failed"
  ok "token pairs passed contrast threshold (light + dark)"

  log "i18n: compile Paraglide + message types"
  (cd "$ROOT/apps/web" && "$web_bin/paraglide-js" compile \
    --project ../../packages/i18n/project.inlang \
    --outdir ./src/lib/paraglide \
    --emit-ts-declarations >/dev/null) || die "Paraglide compilation failed"
  ok "messages compiled"

  log "svelte-check (types + component a11y diagnostics)"
  # `--fail-on-warnings` (D-053): compiler warnings — including all `a11y_*` diagnostics —
  # block.
  (cd "$ROOT/apps/web" && "$web_bin/svelte-kit" sync >/dev/null && "$web_bin/svelte-check" --tsconfig ./tsconfig.json --fail-on-warnings) \
    || die "svelte-check found errors or warnings"
  ok "0 error, 0 warning"

  log "unit test web (vitest, fungsi murni)"
  (cd "$ROOT/apps/web" && "$web_bin/vitest" run) || die "web unit tests failed"
  ok "unit test web hijau"

  # API e2e (spec §17.2): only when DB is available. Idempotent migrate + seed dev first,
  # then Playwright starts the compiled binary on port 8099 (see apps/web/playwright.config.ts).
  if [ -z "$KRAN_DATABASE_URL" ]; then
    skip "KRAN_DATABASE_URL is empty — API e2e not run, login/maker-checker flow spec skipped"
  else
    log "API e2e: build + migrate + dev seed"
    cmd_build
    mkdir -p "$BUILD"
    dbt=$(build_tool "$ROOT/tools/dbtools")
    "$dbt" --root "$ROOT" migrate || die "dev DB migration failed"
    "$dbt" --root "$ROOT" seed --dev || die "dev seed failed"
    ok "API e2e ready (idempotent migration + dev seed)"
  fi

  log "e2e (Playwright): axe 2 themes x 2 locales + keyboard-only flow + login/maker-checker flow"
  # Log disimpan supaya jumlah test yang benar-benar dieksekusi bisa diperiksa. Tanpa ambang,
  # spec yang melewati dirinya sendiri (DB/seed hilang) tetap menghasilkan "hijau" — persis
  # kegagalan yang ditutup T-126.
  e2e_log="$BUILD/e2e.log"
  set +e
  (cd "$ROOT/apps/web" && "$web_bin/playwright" test) >"$e2e_log" 2>&1
  e2e_status=$?
  set -e
  cat "$e2e_log"
  [ "$e2e_status" -eq 0 ] || die "e2e failed (log: $e2e_log)"
  if [ -n "${KRAN_DATABASE_URL:-}" ]; then
    passed=$(sed -n 's/.*[^0-9]\([0-9][0-9]*\) passed.*/\1/p' "$e2e_log" | tail -n 1)
    [ -n "$passed" ] || passed=0
    minimum="${KRAN_E2E_MIN_TESTS:-40}"
    case "$minimum" in ''|*[!0-9]*) minimum=40 ;; esac
    [ "$passed" -ge "$minimum" ] \
      || die "e2e hanya menjalankan $passed test (minimum $minimum) - ada spec yang di-skip?"
    ok "e2e green: $passed test"
  else
    ok "e2e green (tanpa KRAN_DATABASE_URL: hanya spec yang tidak butuh API)"
  fi
}

cmd_build() {
  mkdir -p "$BIN"
  [ -f "$ROOT/apps/api/src/main.nim" ] || die "apps/api/src/main.nim not found (T-004)"
  nim c $NIMFLAGS --mm:orc --threads:on --out:"$BIN/kran-api" "$ROOT/apps/api/src/main.nim"
  ok "$BIN/kran-api"
}

cmd_scaffold() { # cmd_scaffold <name> [--dry-run]
  log "scaffold new module"
  [ -d "$ROOT/tools/scaffold" ] || die "tools/scaffold not found (T-011)"
  tool=$(build_tool "$ROOT/tools/scaffold")
  "$tool" --root "$ROOT" "$@" || die "scaffold failed"
}

summarize() {
  if [ -n "$SKIPS" ]; then
    printf '\n== note: targets skipped (not yet present / pending decision):%s\n' "$SKIPS"
  fi
}

cmd_lint_web() {
  # Bagian dari `./task ci`, bukan `./task check` (D-139): job CI `nim-check` tidak menjalankan
  # `pnpm install`, jadi lint TS/Svelte di sana akan selalu skip. Gate web berjalan di job
  # `web-e2e` dan di mesin developer yang sudah `pnpm install`.
  if [ ! -f "$ROOT/package.json" ]; then
    skip "package.json not found — eslint skipped"
    return 0
  fi
  if [ ! -x "$ROOT/node_modules/.bin/eslint" ]; then
    skip "JS dependencies not installed (run: pnpm install) — eslint skipped"
    return 0
  fi
  log "eslint (typescript-eslint + svelte/*, non-a11y)"
  (cd "$ROOT" && "$ROOT/node_modules/.bin/eslint" apps/web/src packages/ui/src) \
    || die "eslint found errors"
  ok "eslint clean (apps/web + packages/ui)"
}

cmd_ci() {
  # Gate tanpa database bukan gate: integrasi dan e2e DB akan di-skip dan hasilnya hijau palsu
  # (T-126). Dry run eksplisit tetap mungkin lewat KRAN_ALLOW_NO_DB=1.
  if [ -z "${KRAN_DATABASE_URL:-}" ] && [ "${KRAN_ALLOW_NO_DB:-0}" != "1" ]; then
    die "./task ci butuh KRAN_DATABASE_URL (integrasi + e2e DB). Tanpa DB: KRAN_ALLOW_NO_DB=1 ./task ci"
  fi
  log "commit $(git rev-parse --short HEAD 2>/dev/null || echo '-')"
  cmd_check
  cmd_openapi
  cmd_lint_web
  cmd_test
  cmd_e2e
  summarize
  printf '\n== CI green\n'
}

# Stability gate: `./task ci` answers "passes now", not "stable". Flakes only show on repeat,
# so the full gate runs N times consecutively and halts at the first red round (T-031).
cmd_ci_repeat() { # cmd_ci_repeat [round-count]
  total_rounds=${1:-3}
  case "$total_rounds" in
    '' | *[!0-9]*) die "repeat count must be a number (e.g. ./task ci-repeat 3)" ;;
  esac
  [ "$total_rounds" -ge 1 ] || die "repeat count must be at least 1"
  round=1
  while [ "$round" -le "$total_rounds" ]; do
    log "ci-repeat: round $round/$total_rounds"
    cmd_ci || die "ci-repeat failed on round $round/$total_rounds"
    round=$((round + 1))
  done
  printf '\n== ci-repeat green: %s consecutive rounds\n' "$total_rounds"
}

cmd_help() {
  # Print file header comment block: from line 2 to first non-comment line.
  # Does not use fixed line numbers so adding commands won't truncate help silently.
  sed -n '2,/^[^#]/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'
}

case "${1:-help}" in
  check) cmd_check ;;
  check-fast) cmd_check_fast ;;
  verify) shift; cmd_verify "${1:-}" ;;
  test) shift; cmd_test "${1:-}" ;;
  e2e) cmd_e2e ;;
  lint-web) cmd_lint_web ;;
  ci) cmd_ci ;;
  ci-repeat) shift; cmd_ci_repeat "${1:-3}" ;;
  build) cmd_build ;;
  fmt) cmd_fmt ;;
  lint) cmd_lint ;;
  archcheck) mkdir -p "$BUILD"; cmd_archcheck ;;
  nomagic) mkdir -p "$BUILD"; cmd_nomagic ;;
  paramgen) mkdir -p "$BUILD"; cmd_paramgen ;;
  paramgen-gen) mkdir -p "$BUILD"; cmd_paramgen_gen ;;
  i18n) mkdir -p "$BUILD"; cmd_i18n ;;
  openapi) mkdir -p "$BUILD"; cmd_openapi ;;
  openapi-gen) mkdir -p "$BUILD"; cmd_openapi_gen ;;
  devdb) shift; exec "$ROOT/tools/devdb.sh" "$@" ;;
  dbtools) shift; mkdir -p "$BUILD"; tool=$(build_tool "$ROOT/tools/dbtools"); "$tool" --root "$ROOT" "$@" ;;
  scaffold) shift; mkdir -p "$BUILD"; cmd_scaffold "$@" ;;
  bench-password)
    # `-d:release` is intentional: production binary is also release (`apps/api/Dockerfile:41`).
    shift
    mkdir -p "$BIN"
    nim c -d:release $NIMFLAGS --out:"$BIN/bench-password" "$ROOT/tools/bench-password/main.nim" >/dev/null \
      || die "failed to build bench-password tool"
    exec "$BIN/bench-password" "$@"
    ;;
  help | -h | --help) cmd_help ;;
  *) die "unknown command: $1 (try ./task help)" ;;
esac
